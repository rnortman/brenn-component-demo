// The document a deployer copies from: both demo pages wired, described and
// ready to boot, under a developer's own settings.
//
// `make run` boots this with brenn's three install roots and this bundle's
// three, which is the whole system from a consumer's checkout. `dev_fit`
// compiles it against the two module roots a host would resolve it from.

// Both pages, their stamps and the app, in one place both documents stamp: the
// only intended difference between this file and its twin is the environment
// settings below.
use deployment::*;

/// Where the server listens and what it believes about the proxy in front. The
/// frontend tree is brenn's build output, reached through this module's bazel
/// symlink; the surface trees are boot flags, not config, so they are named on
/// the command line instead.
server {
  bind_address = "127.0.0.1:3200";
  static_dir = ".bazel-bin/external/brenn+/frontend/dist";
  secure_cookies = false;
  public_url = "http://127.0.0.1:3200";
}

database {
  path = "target/dev/demo.db";
}

logging {
  log_dir = "target/dev/logs";
  console_level = debug;
  file_level = debug;
}

/// The MCP script path must resolve at runtime — nothing checks it until a user
/// opens the app. Staged from brenn by `//:noop_mcp`.
claude_defaults {
  mcp_script_path = ".bazel-bin/noop_mcp.py";
  model = "sonnet";
}

/// Where surface error reports land. This deployment runs no alerter.
observability {
  surface_error_channel = "brenn:surface-errors";
}

/// Self-description channel prefix and heartbeat cadence for surfaces.
surface_description {
  prefix = "surface";
  status_interval_secs = 60;
}

/// What every page this deployment hosts may hold: the page words, and the two
/// plane words the split page needs to reach the bus. Declared here rather than
/// beside the stamps it caps because a ceiling is one deployment's consent, and
/// each root document is one deployment; `deployment.brenn`'s header carries
/// the argument and what the duplication costs.
principal demo_ui {
  grants = [dom, log, page-dom, ports, publish, subscribe];
}

new demo-app: Demo;
new deployment: DemoDeployment(ui = demo_ui);
