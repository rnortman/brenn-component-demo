# Directories Bazel must not traverse. No wildcards are permitted here, so
# each path is spelled out; the convenience symlinks are named after
# --symlink_prefix in .bazelrc, and the last of them after the checkout
# directory itself.
.git
.bazel-bin
.bazel-brenn-component-demo
.bazel-out
.bazel-testlogs
.bazel-disk-cache
.bazel-repo-cache
.dev-mounts
target
e2e/node_modules
e2e/test-results
e2e/playwright-report
e2e/blob-report
e2e/.auth
